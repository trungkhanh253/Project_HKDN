# Sao chép file này thành .env rồi sửa giá trị:  copy .env.example .env
# KHÔNG commit file .env lên Git.
#
# Lưu ý: docker-compose.yml hiện chỉ đọc POSTGRES_PASSWORD và REDIS_URL từ file này.
# Các biến còn lại để tài liệu hóa / dùng khi chạy tay, và sẽ có tác dụng khi
# nhóm Server bổ sung `env_file` hoặc `environment` tương ứng cho service api/worker.

# --- PostgreSQL (service "postgres") ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=attendance_server

# Chuỗi kết nối dùng TRONG container (host = tên service "postgres").
# Mật khẩu phải GIỐNG POSTGRES_PASSWORD ở trên.
DATABASE_URL=postgresql://postgres:change_me_strong_password@postgres:5432/attendance_server

# --- Redis / RQ ---
REDIS_URL=redis://redis:6379/0

# --- Flask ---
# Sinh khóa ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_random_64_hex_chars

# --- Chỉ dùng khi chạy pytest từ máy host (Windows), không dùng trong container ---
# Dùng "localhost", không dùng "postgres". DB test tách riêng với DB chạy thật.
TEST_DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5432/attendance_test
TEST_BASE_URL=http://localhost:5000
