<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nguyễn Văn A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary" />

    <TextView
        android:id="@+id/dialogStudentId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MSSV: 2251120186"
        android:textSize="13sp"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp" />

    <!-- Đúng giờ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="• Đúng giờ"
            android:textSize="15sp"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:id="@+id/dialogOnTimeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 buổi"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#00796B" />
    </LinearLayout>

    <!-- Đi muộn -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="• Đi muộn"
            android:textSize="15sp"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:id="@+id/dialogLateCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 buổi"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FB8C00" />
    </LinearLayout>

    <!-- Vắng mặt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="• Vắng mặt"
            android:textSize="15sp"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:id="@+id/dialogAbsentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 buổi"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#D32F2F" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/dialogTotalSessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tổng số buổi học: 0"
        android:textSize="13sp"
        android:textColor="@color/colorTextSecondary" />

</LinearLayout>