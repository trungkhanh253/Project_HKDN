<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    tools:context=".AttendanceManagementActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/gradient_background"
            app:title="Quản lý điểm danh"
            app:titleTextColor="@android:color/white"
            app:popupTheme="@style/AppTheme.PopupOverlay" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/textSubjectInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Môn học: Đang tải..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/textRecordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số bản ghi điểm danh: 0"
            android:textSize="14sp"
            android:textColor="#CCFFFFFF"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorCard"
        android:elevation="2dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnTabExport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Xuất dữ liệu"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimaryDark"
            android:background="@android:color/transparent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnTabEmail"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Gửi email"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:background="@android:color/transparent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnTabItemView"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Xem chi tiết"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:background="@android:color/transparent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/layoutExportTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/colorCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xuất dữ liệu điểm danh"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimaryDark"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xuất toàn bộ dữ liệu danh sách học viên và lịch sử điểm danh của môn học này ra tệp định dạng CSV."
                            android:textSize="14sp"
                            android:textColor="@color/colorTextSecondary"
                            android:layout_marginBottom="20dp" />

                        <Button
                            android:id="@+id/btnExportCsv"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Xuất tệp CSV"
                            android:textSize="15sp"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:background="@drawable/button_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <RelativeLayout
            android:id="@+id/layoutEmailTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <Button
                android:id="@+id/btnSendEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:text="Gửi báo cáo qua Email"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/button_primary"
                android:enabled="true" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/btnSendEmail"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="@color/colorCard"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thêm người nhận báo cáo"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimaryDark"
                                android:layout_marginBottom="16dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Địa chỉ email"
                                android:textSize="13sp"
                                android:textColor="@color/colorTextSecondary"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/editEmailAddress"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edit_text_background"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textSize="14sp"
                                android:textColor="@color/colorTextPrimary"
                                android:hint="Nhập địa chỉ email"
                                android:textColorHint="@color/colorTextHint"
                                android:inputType="textEmailAddress"
                                android:layout_marginBottom="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tên người nhận"
                                android:textSize="13sp"
                                android:textColor="@color/colorTextSecondary"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/editRecipientName"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/edit_text_background"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textSize="14sp"
                                android:textColor="@color/colorTextPrimary"
                                android:hint="Nhập tên người nhận (không bắt buộc)"
                                android:textColorHint="@color/colorTextHint"
                                android:inputType="textPersonName"
                                android:layout_marginBottom="16dp" />

                            <Button
                                android:id="@+id/btnAddEmail"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:text="Thêm vào danh sách"
                                android:textSize="14sp"
                                android:textAllCaps="false"
                                android:textColor="@color/colorPrimaryDark"
                                android:background="@drawable/button_secondary" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="@color/colorCard"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Danh sách email nhận"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/colorPrimaryDark" />

                                <Button
                                    android:id="@+id/btnImportEmailCsv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:text="Nhập từ CSV"
                                    android:textSize="12sp"
                                    android:textAllCaps="false"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:background="@drawable/button_secondary"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <CheckBox
                                    android:id="@+id/checkBoxSelectAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Chọn tất cả"
                                    android:textSize="14sp"
                                    android:textColor="@color/colorTextPrimary" />

                                <TextView
                                    android:id="@+id/textSelectedCount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:text="Đã chọn: 0 email"
                                    android:textSize="13sp"
                                    android:textColor="@color/colorTextSecondary" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="200dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recyclerEmailList"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scrollbars="vertical" />

                                <TextView
                                    android:id="@+id/textEmptyEmailList"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="Chưa có địa chỉ email nào"
                                    android:textSize="14sp"
                                    android:textColor="@color/colorTextHint" />
                            </FrameLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layoutViewTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/subTabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorCard"
                app:tabTextColor="@color/colorTextSecondary"
                app:tabSelectedTextColor="@color/colorPrimaryDark"
                app:tabIndicatorColor="@color/colorPrimary">
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng quan" />
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chi tiết" />
            </com.google.android.material.tabs.TabLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:background="@color/colorBackground">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/viewModeTabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@color/colorCard"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabTextColor="@color/colorTextSecondary"
                    app:tabSelectedTextColor="@color/colorPrimaryDark"
                    app:tabIndicatorColor="@color/colorPrimary"
                    app:tabIndicatorFullWidth="true" />

                <Button
                    android:id="@+id/btnSelectDateRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ngày: Đang tải..."
                    android:textAllCaps="false"
                    android:background="@drawable/button_secondary"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ScrollView
                    android:id="@+id/layoutSubTabOverview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/pieChartAttendance"
                            android:layout_width="match_parent"
                            android:layout_height="320dp"
                            android:layout_marginBottom="8dp"
                            android:background="@android:color/white"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="16dp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="@color/colorCard"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/txtNoChartDataMessage"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Không có dữ liệu điểm danh cho thời gian này."
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:gravity="center"
                                    android:paddingTop="14dp"
                                    android:paddingBottom="14dp"
                                    android:layout_marginBottom="10dp"
                                    android:visibility="gone" />

                                <GridLayout
                                    android:id="@+id/gridChartStats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:columnCount="2"
                                    android:rowCount="2"
                                    android:alignmentMode="alignBounds">

                                    <TextView
                                        android:id="@+id/txtStatRow1"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_columnWeight="1"
                                        android:layout_marginBottom="8dp"
                                        android:text="• Sĩ số: --"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorTextPrimary" />

                                    <TextView
                                        android:id="@+id/txtStatRow2"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_columnWeight="1"
                                        android:layout_marginBottom="8dp"
                                        android:text="• Đúng giờ: --"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorTextPrimary" />

                                    <TextView
                                        android:id="@+id/txtStatRow3"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_columnWeight="1"
                                        android:text="• Đi muộn: --"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorTextPrimary" />

                                    <TextView
                                        android:id="@+id/txtStatRow4"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_columnWeight="1"
                                        android:text="• Vắng mặt: --"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorTextPrimary" />
                                </GridLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </ScrollView>

                <LinearLayout
                    android:id="@+id/layoutSubTabDetail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/statusTabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorCard"
                        app:tabMode="fixed"
                        app:tabTextColor="@color/colorTextSecondary"
                        app:tabSelectedTextColor="@color/colorPrimaryDark"
                        app:tabIndicatorColor="@color/colorPrimary">
                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đúng giờ" />
                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đi muộn" />
                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vắng mặt" />
                    </com.google.android.material.tabs.TabLayout>

                    <TextView
                        android:id="@+id/textViewStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:background="@color/cardAccentTeal"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimaryDark"
                        android:text="Thống kê danh sách điểm danh" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerAttendanceList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:clipToPadding="false"
                            android:scrollbars="vertical" />

                        <TextView
                            android:id="@+id/textEmptyAttendanceList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Không có dữ liệu điểm danh cho thời gian này."
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimaryDark"
                            android:padding="16dp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>